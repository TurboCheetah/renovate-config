{"$schema":"https://docs.renovatebot.com/renovate-schema.json","description":"Shared TurboCheetah preset: grouped non-major updates, weekly lock file maintenance, automerge for green minor/patch and lock file bumps, majors stay manual.","extends":["config:recommended","helpers:pinGitHubActionDigests","group:allNonMajor",":enableVulnerabilityAlerts"],"labels":["Meta: Dependencies"],"lockFileMaintenance":{"automerge":true,"enabled":true,"schedule":["before 12pm on Sunday"]},"minimumReleaseAge":"3 days","osvVulnerabilityAlerts":true,"packageRules":[{"automerge":true,"description":"Automerge minor, patch, pin and digest updates once CI is green.","matchUpdateTypes":["minor","patch","pin","digest"]},{"automerge":false,"description":"Major bumps always stay manual.","matchUpdateTypes":["major"]}],"schedule":["before 12pm on Sunday"],"vulnerabilityAlerts":{"addLabels":["security"],"vulnerabilityFixStrategy":"lowest"}}