{"$schema":"https://docs.renovatebot.com/renovate-schema.json","description":"Shared TurboCheetah preset: grouped non-major updates, automerge for green minor/patch bumps, majors stay manual.","extends":["config:recommended","helpers:pinGitHubActionDigests","group:allNonMajor",":enableVulnerabilityAlerts"],"labels":["Meta: Dependencies"],"minimumReleaseAge":"3 days","osvVulnerabilityAlerts":true,"packageRules":[{"automerge":true,"description":"Automerge minor, patch, pin and digest updates once CI is green.","matchUpdateTypes":["minor","patch","pin","digest"]},{"automerge":false,"description":"Major bumps always stay manual.","matchUpdateTypes":["major"]}],"schedule":["before 12pm on Sunday"],"vulnerabilityAlerts":{"addLabels":["security"],"vulnerabilityFixStrategy":"lowest"}}